  {
    "id": "cs301-l07-notes-tree-height",
    "institutionId": "onestop-demo",
    "facultyId": "faculty-nk",
    "courseId": "cs-301",
    "courseName": "Data Structures & Algorithms",
    "lectureId": "cs-301-lecture-07",
    "lectureTitle": "Tree Foundations",
    "lectureSequence": 7,
    "topic": "Height and depth",
    "sourceType": "notes",
    "sourceName": "Lecture 07 Notes",
    "section": "Height basics",
    "page": 2,
    "updatedAt": "2026-08-12T09:00:00.000Z",
    "content": "Tree height measures the longest path from the root to a leaf. If the tree becomes skewed, operations that depend on path length degrade toward linear time."
  },
