    "topic": "Traversals",
    "sourceType": "slides",
    "sourceName": "Lecture 08 Slides",
    "section": "Traversal recap",
    "page": 11,
    "updatedAt": "2026-08-13T09:10:00.000Z",
    "content": "Preorder visits root before subtrees, inorder visits left subtree then root then right subtree, and postorder visits root last. In binary search trees, inorder traversal yields values in sorted order."
  },
